# Base platform domain used by host parsing and local development (use "localhost" in dev)
ROOT_DOMAIN=localhost

# Tenant-facing application connection (non-owner, NOBYPASSRLS) — enforces Postgres RLS
DATABASE_URL="postgresql://app_user:app_user_dev_pw_only@localhost:5432/hotel?schema=public"

# Prisma migration connection (table/database owner, CREATEDB for shadow DB)
MIGRATE_DATABASE_URL="postgresql://migrator:migrator_dev_pw_only@localhost:5432/hotel?schema=public"

# Platform-admin connection (BYPASSRLS) — restricted to platform console, provisioning, webhooks, and purge jobs
ADMIN_DATABASE_URL="postgresql://platform_admin:platform_admin_dev_pw_only@localhost:5432/hotel?schema=public"

# Local Redis instance standing in for the tenant-resolution KV store and rate limiter
REDIS_URL="redis://localhost:6379"
